# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.uv-cache/

# Rust
rust/**/target/

# Build outputs
build/
output/
# ...including an `output` SYMLINK: a worktree has no output/ of its own, but a queued job that
# runs from the worktree (gpu_submit.sh cds there) resolves a config's relative `run_dir:
# output/runs/...` against it, so agents symlink it to $TRIPPY_OUTPUT. `output/` alone does not
# match a symlink.
output

# Third-party / upstream code
third_party/

# Models and large files
*.pt
*.pth
*.ckpt
*.safetensors
*.ply
*.sog
*.npy
*.npz

# Images and video (except test fixtures)
*.png
*.jpg
*.jpeg
*.heic
*.gif
*.mp4
*.mov
!tests/fixtures/synthetic/**/*.png
!tests/fixtures/synthetic/**/*.jpg

# Environment
.env

# OS
.DS_Store
.worktrees/
